# Poseidon no requiere variables de entorno mientras use persistencia local.
# Agregar aqui solamente nombres y ejemplos publicos. Nunca incluir secretos.
VITE_POSEIDON_BACKEND=local

# Solo para una beta Supabase explicitamente habilitada. La clave publicable no
# reemplaza RLS ni las funciones transaccionales. Nunca usar service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
