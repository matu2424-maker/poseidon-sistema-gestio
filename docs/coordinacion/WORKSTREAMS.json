      "AGENTS.md",
      "package.json",
      "scripts/",
      "src/App.tsx",
      "src/types.ts",
      "src/application/",
      "src/data/",
      "src/infrastructure/",
      "src/navigation/",
      "src/lib/",
      "src/components/",
      "src/features/dashboard/RoleDashboard.tsx",
      "src/features/dashboard/DashboardActionCard.tsx",
      "src/styles/global.css",
      "src/styles/base.css",
      "src/styles/layout.css",
      "src/styles/responsive.css",
      "src/styles/features/dashboards.css",
