    {
      "id": "poseidon-encargado",
      "title": "Poseidon Encargado",
      "prompt": "docs/prompts/CHAT_ENCARGADO_POSEIDON.md",
      "context": "docs/contextos/CODEX_ENCARGADO.md",
      "writeScopes": [
        "src/features/manager/",
        "src/features/dashboard/ManagerDashboard.tsx",
        "src/styles/features/dashboard-manager.css",
        "docs/contextos/CODEX_ENCARGADO.md",
        "docs/modulos/07_panel_encargado.md"
      ],
      "requiredChecks": ["pnpm run check", "pnpm run build", "pnpm run check:commit"]
    },
    {
      "id": "poseidon-administrador",
      "title": "Poseidon Administrador",
