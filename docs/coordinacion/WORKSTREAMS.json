        "docs/modulos/08_panel_administrador.md"
      ],
      "requiredChecks": ["pnpm run check", "pnpm run build", "pnpm run check:commit"]
    }
  ],
  "supportChats": [
    {
      "id": "poseidon-calidad",
      "title": "Poseidon Calidad y Pruebas",
      "prompt": "docs/prompts/CHAT_CALIDAD_POSEIDON.md",
      "context": "docs/contextos/CODEX_CALIDAD_PRUEBAS.md",
